mutate(
protected = ifelse(protected_area == "Y", "Protected", "Unprotected")
) %>%
group_by(east_or_west, habitat, protected) %>%
summarise(n = n(), .groups = "drop") %>%
pivot_wider(names_from = protected, values_from = n, values_fill = 0) %>%
mutate(Total = Protected + Unprotected) %>%
arrange(east_or_west, habitat)
read_csv("./output/table_s1_sample_metadata_qc.csv") %>%
count(`Final analysis status`)
